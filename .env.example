# Booking API — the ines-booking Worker in workers/booking/.
# Without it the booking page renders its setup placeholder instead of a
# calendar that cannot work. See docs-booking-system.md.
NEXT_PUBLIC_BOOKING_API_BASE_URL=https://ines-booking.example.workers.dev

# Stripe Checkout. Publishable keys are safe in the browser; secret and
# webhook keys live only in Cloudflare Worker secrets. Use `test` only when the
# API URL points at the isolated staging Worker.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_EXPECTED_MODE=live

# Google Sign-In client id, from Google Cloud Console. Public by design, and
# optional: with it unset the Google button simply does not render and email
# and password carries on working.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Advertised fee for changing or cancelling on the lesson day. In postpay mode
# the Worker charges it to the saved card; older bookings retain their terms.
NEXT_PUBLIC_SAME_DAY_RESCHEDULE_FEE_CENTS=500

# No secrets belong in this file or in any NEXT_PUBLIC_ variable. The Worker's
# token secret, admin token and mail API key are Cloudflare Worker secrets.
