# Cloudflare Pages response headers.
#
# Security headers first, on everything. The site had none of its own — only the
# two Cloudflare sets by default — so a CSP is the meaningful addition: the page
# loads Google's sign-in script and fonts and nothing else, which is narrow
# enough to state exactly.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.googleusercontent.com https://accounts.google.com https://*.stripe.com; frame-src https://accounts.google.com https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; connect-src 'self' https://ines-booking.dakibwa.workers.dev https://accounts.google.com https://api.stripe.com https://checkout.stripe.com https://m.stripe.network https://r.stripe.com
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://js.stripe.com" "https://checkout.stripe.com")

#
# Without this file Pages serves everything with `max-age=14400, must-revalidate`,
# which makes the browser re-check the fonts, CSS and JS on every visit once four
# hours have passed. Everything under /_next/static/ carries a content hash in its
# filename, so a changed file is always a different URL and the old one can be
# cached indefinitely.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Production assets are referenced by stable paths, so they cannot be immutable.
# A day of browser caching with revalidation keeps repeat visits cheap without
# stranding an updated image behind a long TTL.
/visuals/*
  Cache-Control: public, max-age=86400, must-revalidate

/icon.svg
  Cache-Control: public, max-age=86400, must-revalidate

# HTML pages: 10-minute browser cache with revalidation. Short enough to pick up
# deploys within minutes, long enough to skip re-fetch on quick return visits.
/
  Cache-Control: public, max-age=600, must-revalidate

/approach/
  Cache-Control: public, max-age=600, must-revalidate

/lessons/
  Cache-Control: public, max-age=600, must-revalidate

/faq/
  Cache-Control: public, max-age=600, must-revalidate

/book/
  # Keep the real mailto link in the HTML. Cloudflare's email obfuscation
  # rewrites it to a JavaScript-only /cdn-cgi/ URL that 404s without scripts.
  Cache-Control: public, max-age=600, must-revalidate, no-transform

/terms/
  Cache-Control: public, max-age=600, must-revalidate, no-transform

/booking-terms/
  Cache-Control: public, max-age=600, must-revalidate, no-transform

/privacy/
  Cache-Control: public, max-age=600, must-revalidate, no-transform

# The account pages were missing from this list entirely, so they fell back to
# the Pages default of four hours — a deploy took that long to reach anyone
# already carrying the old shell. Their contents come from the API at runtime,
# so this is about the page itself catching up, not the lessons in it.
/my-lessons/
  Cache-Control: public, max-age=600, must-revalidate, no-transform

/booking/
  Cache-Control: public, max-age=600, must-revalidate, no-transform

/schedule/
  Cache-Control: public, max-age=600, must-revalidate

/reset-password/
  Cache-Control: public, max-age=600, must-revalidate
