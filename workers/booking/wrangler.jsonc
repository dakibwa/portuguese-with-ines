{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ines-booking",
  "main": "index.mjs",
  "compatibility_date": "2026-08-31",
  // Every minute for end-of-lesson charges; the 03:10 UTC tick also performs the
  // nightly open-ended-series extension sweep.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ines-booking",
      "database_id": "e61786c2-f195-4087-b276-5f20bf64c429"
    }
  ],
  "vars": {
    // Origins allowed to call the live API: the live domains, plus
    // localhost:3000 because CI serves the built export there for the journey
    // tests. Local development sets its own list in .dev.vars and the dev
    // environment below.
    "ALLOWED_ORIGIN": "https://portuguesewithines.com,https://portuguescomaines.com,http://localhost:3000",
    "SITE_URL": "https://portuguesewithines.com",
    "MAIL_FROM": "Português com a Inês <bookings@portuguesewithines.com>",
    "MAIL_SENDER_ADDRESS": "bookings@portuguesewithines.com",
    // portuguesewithines.com was verified in Resend on 26 August 2026 (DKIM,
    // SPF MX and SPF TXT all confirmed), so mail sends for real. Setting this
    // back to "1" stops all sending and records to email_log instead, which is
    // what to do while testing rather than pointing it at a spare address.
    "EMAIL_DRY_RUN": "0",
    // Send Inês's booking, change and failed-payment copies to TEACHER_EMAIL.
    // Setting this to "0" pauses these copies; student mail stays live.
    "TEACHER_NOTIFICATIONS_ENABLED": "1",
    // Enable only after the additive migration, OAuth app setup and secrets.
    "GOOGLE_CALENDAR_ENABLED": "1",
    // Checkout mounts inside the booking page rather than redirecting to
    // Stripe. Inert until the Stripe secrets exist and payment_mode is postpay.
    "STRIPE_UI_MODE": "embedded",
    // A sandbox key under the production secret name must never be enough to
    // open checkout. Health and booking both fail closed until this is live.
    "STRIPE_EXPECTED_MODE": "live",
    // Google Sign-In. Public by design — it identifies the app, and the Worker
    // verifies every ID token's signature and audience against it. The client
    // *secret* is not needed: this is the ID-token flow, not the server-side
    // code exchange.
    "GOOGLE_CLIENT_ID": "174786285888-cq6vhf2jifpn5bdjutade6fe8an5i9ob.apps.googleusercontent.com"
  },
  "secrets": {
    // wrangler secret put <NAME> --config workers/booking/wrangler.jsonc
    //
    // STRIPE_SECRET_KEY is a least-privilege restricted key (rk_…), not the
    // account's general secret key. Both Stripe secrets remain optional here:
    // payment_mode defaults to 'off', so booking works fully without them, and
    // the site must not be blocked from shipping on a payment rail that does not
    // exist yet.
    "required": ["BOOKING_TOKEN_SECRET", "ADMIN_TOKEN", "RESEND_API_KEY", "TEACHER_EMAIL"]
  },
  "env": {
    // Isolated payment proving ground. It has its own empty D1 database, uses
    // Stripe sandbox credentials, and records email deliveries without sending
    // them. The public site never points here; local QA does so explicitly.
    "staging": {
      "name": "ines-booking-staging",
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ines-booking-staging",
          "database_id": "b4b5af8e-2fdc-4ea9-a5e7-0cc91688fc0f"
        }
      ],
      "vars": {
        "ALLOWED_ORIGIN": "http://localhost:3002,http://127.0.0.1:3002,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3211",
        "SITE_URL": "http://localhost:3211",
        "MAIL_FROM": "Português com a Inês <bookings@portuguesewithines.com>",
        "MAIL_SENDER_ADDRESS": "bookings@portuguesewithines.com",
        "EMAIL_DRY_RUN": "1",
        "TEACHER_NOTIFICATIONS_ENABLED": "0",
        "GOOGLE_CALENDAR_ENABLED": "1",
        "STRIPE_UI_MODE": "embedded",
        "STRIPE_EXPECTED_MODE": "test",
        "GOOGLE_CLIENT_ID": "174786285888-cq6vhf2jifpn5bdjutade6fe8an5i9ob.apps.googleusercontent.com",
        "TEACHER_EMAIL": "test@example.invalid"
      },
      "secrets": {
        "required": ["BOOKING_TOKEN_SECRET", "ADMIN_TOKEN", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
      }
    }
  }
}
